cabal-version:      3.0
name:               open-slop
version:            0.1.0.0
synopsis:           A Nix-configured local LLM machine: catalogue, engines, jobs, client, gateway, typed stages
license:            AGPL-3.0-or-later
author:             Harry Pray IV
maintainer:         harry@harryprayiv.com
build-type:         Simple

-- llmq-grace links Grace, whose closure keeps a reference to the compiler,
-- which puts 4.6 GB into any output containing it. The fleet's binaries
-- (llmq, open-slop-gateway) must not carry that to a Pi, so the executable
-- that needs Grace is behind a flag: the package builds without it by
-- default, and the workstation build turns it on.
flag grace
  description: Build llmq-grace, which links Grace and the compiler with it.
  default:     False
  manual:      True

common shared
  default-language: GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    DeriveAnyClass
    DuplicateRecordFields
    LambdaCase
    NamedFieldPuns
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    StrictData
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wredundant-constraints
    -Wpartial-fields
    -Wunused-packages
  build-depends:
    base >=4.16 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    OpenSlop.Catalogue
    OpenSlop.Chunk
    OpenSlop.Engine
    OpenSlop.Gateway.Keys
    OpenSlop.Gateway.Route
    OpenSlop.Gateway.Server
    OpenSlop.Gateway.Translate
    OpenSlop.Grace.Docs
    OpenSlop.Http
    OpenSlop.Job
    OpenSlop.OpenAI
    OpenSlop.Stats
  build-depends:
    aeson >=2.1,
    bytestring,
    containers,
    cryptohash-sha256,
    base16-bytestring,
    directory,
    filelock,
    filepath,
    http-client,
    http-client-tls,
    http-types,
    text,
    time,
    wai

executable llmq
  import:          shared
  hs-source-dirs:  app/llmq
  main-is:         Main.hs
  other-modules:
    Menu
    Run
  ghc-options:     -threaded -rtsopts
  build-depends:
    open-slop,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    optparse-applicative,
    text,
    time,
    typed-process,
    unix

executable open-slop-gateway
  import:          shared
  hs-source-dirs:  app/gateway
  main-is:         Main.hs
  ghc-options:     -threaded -rtsopts
  build-depends:
    open-slop,
    aeson,
    optparse-applicative,
    text,
    time,
    warp,
    warp-tls

executable llmq-grace
  import:          shared
  hs-source-dirs:  app/llmq-grace
  main-is:         Main.hs
  other-modules:
    Stage
  ghc-options:     -threaded -rtsopts
  if !flag(grace)
    buildable:     False
  build-depends:
    open-slop,
    aeson,
    bytestring,
    directory,
    filepath,
    grace,
    optparse-applicative,
    text,
    time,
    unix

test-suite open-slop-test
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  build-depends:
    open-slop,
    aeson,
    bytestring,
    containers,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    text